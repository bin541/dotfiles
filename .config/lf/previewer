#!/bin/sh
# Dependencies: chafa, file, coreutils, poppler, ffmpegthumbnailer

file=${1-}
w=${2:-80}
h=${3:-24}

ulimit -c 0 2>/dev/null || :
ulimit -t 10 2>/dev/null || :
ulimit -v 2097152 2>/dev/null || :

case "$w" in ''|*[!0-9]*|0*) w=80 ;; esac
case "$h" in ''|*[!0-9]*|0*) h=24 ;; esac
[ "${#w}" -le 3 ] || w=80
[ "${#h}" -le 3 ] || h=24

text_preview() {
    tr -d '\000-\010\013-\037\177' |
        expand |
        fold -w "$w" |
        head -n "$h"
}

file=$(realpath -q -e -- "$file" 2>/dev/null) ||
    { printf 'Unreadable or missing file\n'; exit 1; }

[ -r "$file" ] || { printf 'Unreadable or missing file\n'; exit 1; }
[ -d "$file" ] && {
    exec ls -Ahlp --color=always --quoting-style=shell-escape -- "$file"
}
[ -f "$file" ] || { printf 'Not a regular file\n'; exit 0; }

mimeinfo=$(file -b --mime -- "$file" 2>/dev/null) || mimeinfo=
mime=${mimeinfo%%;*}

case "$mime" in
    image/*)
        exec timeout 10s chafa -s "${w}x${h}" --format=sixel --animate=false -- "$file" 2>/dev/null
        ;;
    video/*)
        timeout 20s ffmpegthumbnailer -i "$file" -o /dev/stdout -c jpeg -s 800 -q 5 2>/dev/null |
            timeout 10s chafa -s "${w}x${h}" --format=sixel --animate=false - 2>/dev/null
        exit
        ;;
    application/pdf)
        timeout 20s pdftocairo -jpeg -singlefile -f 1 -l 1 -scale-to 800 -- "$file" - 2>/dev/null |
            timeout 10s chafa -s "${w}x${h}" --format=sixel --animate=false - 2>/dev/null
        exit
        ;;
esac

case "$mime" in
    text/*|application/json|application/xhtml+xml|application/xml|application/javascript)
        text_preview <"$file"
        ;;
    *)
        file -b -- "$file" 2>/dev/null | text_preview
        ;;
esac
