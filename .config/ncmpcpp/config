# standard color: black,red,green,yellow,blue,magenta,cyan,white

mpd_host = "localhost"
mpd_port = "6600"
mpd_connection_timeout = 5
mpd_crossfade_time = 5
mpd_music_dir = "~/mus"

ncmpcpp_directory = "~/.config/ncmpcpp"
lyrics_directory = "~/.config/ncmpcpp/lyrics"

song_window_title_format = ncmpcpp
#user_interface = alternative

#header_visibility = no
#statusbar_visibility = no
#titles_visibility = no
display_bitrate = yes

colors_enabled = yes
#header_window_color = green
volume_color = cyan
#state_line_color = blue
state_flags_color = cyan
main_window_color = white
player_state_color = cyan
#statusbar_color = green
#statusbar_time_color = blue
song_columns_list_format = (28)[]{a} (28)[]{b} (0)[]{t|f:Title} (5f)[]{lr}
song_list_format = {%a - }{%b - }{%t}|{$8%f$9}$R{%l}
current_item_prefix = $(black_cyan)
now_playing_prefix = $b$7> $9

progressbar_look = ──
progressbar_color = black
progressbar_elapsed_color = white

visualizer_data_source = /tmp/mpd.fifo
visualizer_output_name = Visualizer feed
visualizer_in_stereo = yes
visualizer_type = spectrum
visualizer_color = cyan
