bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1 && \
wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print ($3=="[MUTED]")?0:int($2*100)}' > $wobsock

bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && \
wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print ($3=="[MUTED]")?0:int($2*100)}' > $wobsock

bindsym --locked XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle && \
wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print ($3=="[MUTED]")?0:int($2*100)}' > $wobsock


bindsym --locked Shift+XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+ -l 1 && \
wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print ($3=="[MUTED]")?0:int($2*100)}' > $wobsock

bindsym --locked Shift+XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%- && \
wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print ($3=="[MUTED]")?0:int($2*100)}' > $wobsock

bindsym --locked Shift+XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && \
wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print ($3=="[MUTED]")?0:int($2*100)}' > $wobsock


bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+  | sed -En 's/.*\(([0-9]+)%\).*/\1/p' > $wobsock
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-  | sed -En 's/.*\(([0-9]+)%\).*/\1/p' > $wobsock

bindsym --locked Shift+XF86MonBrightnessUp exec ddcutil --bus 9 --noverify setvcp 10 + 5 && ddcutil --bus 9 getvcp 10 | \
awk -F"current value = |, max value" '/current value/{print $2}' > $wobsock

bindsym --locked Shift+XF86MonBrightnessDown exec ddcutil --bus 9 --noverify setvcp 10 - 5 && ddcutil --bus 9 getvcp 10 | \
awk -F"current value = |, max value" '/current value/{print $2}' > $wobsock
