# ~/.bash_alias

alias ls='ls --color=auto'
alias grep='grep --color=auto'

alias vim='nvim'

alias gb="git branch"
alias gs="git status"
alias gl="git log --graph --all --abbrev-commit"
alias ga="git add"
alias gm="git commit -m"
alias gp="git push"
alias gr="git reset HEAD~1"
alias gpf="git push origin -f"

alias c="clear"
alias dot="cd /home/rix/pro/dot/ && ls -la"
alias ll="ls -l"
alias sb="source .bashrc"

alias dpsk="ollama run deepseek-r1:14b"
alias qwen="ollama run qwen3.5:9b"

alias os="fastfetch"
